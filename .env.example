# Game server configuration (apps/game-server). Copy to .env for local tweaks.

# HTTP port and bind host.
PORT=8080
HOST=0.0.0.0

# SQLite database file. Use a persistent path/volume in production.
# (The store is swappable for Supabase/Postgres later — see supabase/schema.sql.)
DB_PATH=./cute-poker.db

# Directory of the built web client (index.html + app.js). Defaults to
# ../../web/public relative to the server bundle.
# PUBLIC_DIR=/app/public

# FAST_MODE=1 shrinks bot think-time and inter-hand delays (used by tests).
# Leave unset in production for lifelike 2-8s bot reactions and 20s turn timers.
# FAST_MODE=0
